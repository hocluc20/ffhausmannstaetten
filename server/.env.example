# Kopiervorlage fuer server/.env

# Port der API
PORT=4000

# Schluessel fuer schreibende Zugriffe (POST/PATCH/DELETE) im Header X-API-Key
# und fuer die Anmeldung an der Redaktionsoberflaeche unter /admin.
# Nicht gesetzt = beim ersten Start wird einer erzeugt und in
# data/api-key.txt abgelegt.  FF_API_KEY=off schaltet Schreibzugriffe ab.
FF_API_KEY=

# FF_ADMIN=off blendet die Redaktionsoberflaeche unter /admin aus.
FF_ADMIN=test

# Erlaubte Herkunft fuer Browser-Requests, z. B. https://ffhausmannstaetten.at
# Standard ist "*", das reicht fuer eine oeffentliche Lese-API.
FF_CORS_ORIGIN=*

# Oeffentliche Basis-URL, unter der die API erreichbar ist. Nur noetig, wenn
# ein Reverse Proxy davor haengt - sonst werden Bild-URLs falsch aufgebaut.
# FF_PUBLIC_URL=https://api.ffhausmannstaetten.at

# Quelle fuer den einmaligen WordPress-Import
FF_IMPORT_SOURCE=http://ff-hausmann.bplaced.net/index.php/wp-json/wp/v2
