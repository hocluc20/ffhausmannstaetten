# Keine Source Maps in Produktion: sie waren 3,2 MB gross und haben den
# kompletten Quelltext offengelegt.
GENERATE_SOURCEMAP=false

# Basis-URL der WordPress-REST-API.
# Der Server ist aktuell nur ueber HTTP erreichbar. Diese Website muss daher
# ebenfalls ueber HTTP laufen, sonst blockiert der Browser die Requests als
# Mixed Content. Nach Einrichtung eines Zertifikats auf https:// umstellen.
REACT_APP_API_BASE=http://ff-hausmann.bplaced.net/index.php/wp-json/wp/v2
